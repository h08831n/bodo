# Set default behavior to automatically handle line endings
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to LF on checkout and in repo
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.prisma text eol=lf

# Critical infrastructure files - strictly LF
*.sh text eol=lf
*.sql text eol=lf
init.sql text eol=lf
Dockerfile* text eol=lf
*nginx* text eol=lf
*.conf text eol=lf

# Windows batch scripts - strictly CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pgdump binary
*.zip binary
