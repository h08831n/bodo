{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "declaration": false,
    "declarationMap": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "./dist",
    "types": ["node", "jest"],
    "baseUrl": ".",
    "paths": {
      "@bodo/contracts": ["../../packages/contracts/src/index.ts"],
      "@bodo/contracts/*": ["../../packages/contracts/src/*"],
      "@bodo/utils": ["../../packages/utils/src/index.ts"],
      "@bodo/utils/*": ["../../packages/utils/src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
