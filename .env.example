# ========================================================
# bodo ERP - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# Never commit real production secrets to git repository.
# ========================================================

# Application Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL Connection (Main template connection for apps/api health check & tenant operations)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5433

# Database Isolation Roles Passwords (S1.2)
ERP_PROVISIONER_PASSWORD=provisioner_secret_change_in_prod
ERP_MIGRATOR_PASSWORD=migrator_secret_change_in_prod
ERP_APP_PASSWORD=app_secret_change_in_prod

# Redis Connection (Caches, rates, maintenance flags)
REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@localhost:6379
REDIS_PORT=6379

# Web Application Port & Reverse Proxy
WEB_PORT=80
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Database Manager Security
# Master password used to access /v1/admin/* management endpoints
MASTER_PASSWORD_INITIAL=MasterSecurePassword2026!
DB_MANAGER_ENABLED=true
# Comma-separated list of allowed IPs for Database Manager (empty allows all)
DB_MANAGER_ALLOWED_IPS=
# Whether unauthenticated public endpoint can list active database slugs
DB_LIST_PUBLIC=false
# Automatic schema upgrade on container startup
AUTO_MIGRATE=false

# Multi-Tenant Connection Pool and LRU Settings (S1.3)
TENANT_MAX_CLIENTS=20
TENANT_POOL_SIZE=5
TENANT_IDLE_MS=600000
CONFIG_DIR=./data/config
FILESTORE_DIR=./data/filestore
BACKUP_DIR=./data/backups
LOGS_DIR=./data/logs
MAX_RESTORE_UPLOAD_MB=100
MAX_RESTORE_ENTRIES=100000
DRAIN_TIMEOUT_MS=15000
CLEAN_ORPHANS=false

# PostgreSQL Tools Driver (S1.4)
# 'local' uses local binaries (from PG_BIN_PATH or PATH; default in Linux/Docker/CI)
# 'docker' executes via `docker exec` in PG_DOCKER_CONTAINER (recommended for Windows host dev)
PG_TOOLS_DRIVER=local
PG_DOCKER_CONTAINER=bodo-postgres-dev

# PostgreSQL Binaries Path (for pg_dump and pg_restore in local driver)
# In Linux / Docker this defaults to /usr/bin
PG_BIN_PATH=

# Cryptographic Keys (Must be strong and unique in production)
ADMIN_JWT_SECRET=
JWT_SECRET=super_secret_jwt_key_bodo_2026_min_16_chars
# 32-byte hexadecimal string for AES-256-GCM encryption
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
